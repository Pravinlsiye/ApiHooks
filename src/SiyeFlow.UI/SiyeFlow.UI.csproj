<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SiyeFlow.UI</PackageId>
    <Version>1.0.0</Version>
    <Authors>SiyeFlow</Authors>
    <Description>Embedded UI for visualizing and executing API workflows in ASP.NET Core applications</Description>
    <PackageTags>workflow;api;visualization;swagger-like</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiyeFlow.Core\SiyeFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI\**\*" />
  </ItemGroup>
  
  <Target Name="BuildDesigner" BeforeTargets="PreBuildEvent">
    <Message Text="Building SiyeFlow Designer..." Importance="high" />
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)build-designer.ps1&quot;" />
  </Target>

</Project>
