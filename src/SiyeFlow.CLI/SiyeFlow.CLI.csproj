    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.29" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiyeFlow.Core\SiyeFlow.Core.csproj" />
  </ItemGroup>

