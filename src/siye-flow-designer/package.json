{
  "name": "siye-flow-designer",
  "version": "1.0.0",
  "description": "SiyeFlow Workflow Designer - TypeScript Implementation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "debug": "vite --config vite.config.ts debug-ui/index.html",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type:generate": "cd ../SiyeFlow.Core.TypeGen && dotnet run -- \"../siye-flow-designer/src/models/workflow-models.ts\""
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^20.10.0",
    "@vitest/ui": "^4.0.8",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vitest": "^4.0.8"
  },
  "type": "module"
}
