{
  "name": "CRUD Operations Test",
  "description": "Test Create, Read, Update, Delete operations with cleanup",
  "variables": {
    "testPrefix": "CRUD_TEST"
  },
  "steps": [
    {
      "id": "create-test-user",
      "name": "Create Test User",
      "description": "Create a user for testing CRUD operations",
      "operationId": "createUser",
      "body": {
        "name": "{{testPrefix}} User",
        "username": "crudtest",
        "email": "crud@test.com",
        "address": {
          "street": "456 CRUD Ave",
          "suite": "Test Suite",
          "city": "CRUD City",
          "zipcode": "54321"
        },
        "phone": "555-CRUD",
        "website": "crudtest.com"
      },
      "extractVariables": {
        "testUserId": "$.id"
      },
      "onFailure": {
        "stop": true
      }
    },
    {
      "id": "create-first-post",
      "name": "Create First Post",
      "description": "Create a post to test",
      "operationId": "createPost",
      "body": {
        "userId": "{{testUserId}}",
        "title": "{{testPrefix}}: First Post",
        "body": "This is the first test post for CRUD operations."
      },
      "extractVariables": {
        "firstPostId": "$.id"
      }
    },
    {
      "id": "create-second-post",
      "name": "Create Second Post",
      "description": "Create another post",
      "operationId": "createPost",
      "body": {
        "userId": "{{testUserId}}",
        "title": "{{testPrefix}}: Second Post",
        "body": "This is the second test post."
      },
      "extractVariables": {
        "secondPostId": "$.id"
      }
    },
    {
      "id": "read-user-posts",
      "name": "Read User's Posts",
      "description": "Get all posts for the test user",
      "operationId": "getPosts",
      "parameters": {
        "userId": "{{testUserId}}"
      },
      "extractVariables": {
        "totalPosts": "$.length"
      }
    },
    {
      "id": "update-user",
      "name": "Update Test User",
      "description": "Update the test user's information",
      "operationId": "updateUser",
      "parameters": {
        "userId": "{{testUserId}}"
      },
      "body": {
        "name": "{{testPrefix}} User (Updated)",
        "username": "crudtest_updated",
        "email": "crud_updated@test.com",
        "address": {
          "street": "789 Updated St",
          "suite": "New Suite",
          "city": "Updated City",
          "zipcode": "99999"
        },
        "phone": "555-UPDATE",
        "website": "crudtest-updated.com"
      }
    },
    {
      "id": "verify-update",
      "name": "Verify User Update",
      "description": "Read the user to verify update",
      "operationId": "getUser",
      "parameters": {
        "userId": "{{testUserId}}"
      },
      "extractVariables": {
        "updatedEmail": "$.email"
      }
    },
    {
      "id": "delete-first-post",
      "name": "Delete First Post",
      "description": "Delete the first test post",
      "operationId": "deletePost",
      "parameters": {
        "postId": "{{firstPostId}}"
      }
    },
    {
      "id": "verify-post-deletion",
      "name": "Verify Post Deletion",
      "description": "Try to get the deleted post",
      "operationId": "getPost",
      "parameters": {
        "postId": "{{firstPostId}}"
      },
      "onFailure": {
        "setVariables": {
          "postDeletionVerified": true
        }
      },
      "onSuccess": {
        "setVariables": {
          "postDeletionVerified": false,
          "error": "Post was not deleted properly"
        }
      }
    },
    {
      "id": "cleanup-second-post",
      "name": "Cleanup Second Post",
      "description": "Delete the second post",
      "operationId": "deletePost",
      "parameters": {
        "postId": "{{secondPostId}}"
      }
    },
    {
      "id": "cleanup-user",
      "name": "Cleanup Test User",
      "description": "Delete the test user",
      "operationId": "deleteUser",
      "parameters": {
        "userId": "{{testUserId}}"
      },
      "onSuccess": {
        "setVariables": {
          "cleanupStatus": "completed",
          "message": "All test data cleaned up successfully"
        }
      }
    }
  ]
}
