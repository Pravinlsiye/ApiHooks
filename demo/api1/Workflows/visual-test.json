{
  "name": "Visual Designer Test",
  "description": "Test workflow for the visual designer import",
  "blocks": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "config": {
        "inputs": {
          "baseUrl": {
            "type": "string",
            "required": true,
            "default": "http://localhost:5216"
          }
        }
      },
      "onSuccess": "get-projects"
    },
    {
      "id": "get-projects",
      "type": "http-request",
      "name": "Get All Projects",
      "description": "Fetch the list of projects",
      "config": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects"
      },
      "outputs": {
        "projects": "$"
      },
      "onSuccess": "check-count",
      "onFailure": "error-end"
    },
    {
      "id": "check-count",
      "type": "condition",
      "name": "Check Project Count",
      "description": "Check if we have projects",
      "config": {
        "expression": "{{projects.length}} > 0"
      },
      "onSuccess": "process-projects",
      "onFailure": "no-projects"
    },
    {
      "id": "process-projects",
      "type": "variable",
      "name": "Set Variables",
      "config": {
        "variables": {
          "projectCount": "{{projects.length}}",
          "firstProjectId": "{{projects[0].id}}"
        }
      },
      "onSuccess": "log-result"
    },
    {
      "id": "no-projects",
      "type": "log",
      "name": "No Projects",
      "config": {
        "level": "warning",
        "message": "No projects found!"
      },
      "onSuccess": "end"
    },
    {
      "id": "log-result",
      "type": "log",
      "name": "Log Success",
      "config": {
        "level": "info",
        "message": "Found {{projectCount}} projects"
      },
      "onSuccess": "end"
    },
    {
      "id": "error-end",
      "type": "end",
      "name": "Error End",
      "config": {
        "outputs": {
          "success": {
            "type": "boolean",
            "value": false
          },
          "error": {
            "type": "string",
            "value": "Failed to fetch projects"
          }
        }
      }
    },
    {
      "id": "end",
      "type": "end",
      "name": "Success End",
      "config": {
        "outputs": {
          "success": {
            "type": "boolean",
            "value": true
          },
          "projectCount": {
            "type": "number",
            "value": "{{projectCount}}"
          }
        }
      }
    }
  ]
}
