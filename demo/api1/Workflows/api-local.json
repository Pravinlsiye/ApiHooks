{
  "openapi": "3.0.0",
  "info": {
    "title": "Local Test API",
    "version": "1.0.0",
    "description": "Minimal API spec for local testing (optional)"
  },
  "servers": [
    {
      "url": "http://localhost:5216",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/projects": {
      "get": {
        "operationId": "getProjects",
        "summary": "Get all projects",
        "responses": {
          "200": {
            "description": "List of projects"
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "summary": "Create a project",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created"
          }
        }
      }
    }
  }
}
