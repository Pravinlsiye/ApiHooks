{
  "name": "Test Profiles with Real API",
  "description": "Demonstrates profile feature with real APIs and port-based connections",
  "version": "1.0",
  "blocks": [
    {
      "id": "start1",
      "type": "start",
      "name": "API Configuration",
      "description": "Start with profile selection",
      "config": {
        "profiles": [
          {
            "name": "JSONPlaceholder",
            "description": "Public test API",
            "default": true,
            "inputs": {
              "apiUrl": {
                "type": "string",
                "value": "https://jsonplaceholder.typicode.com",
                "required": true,
                "description": "JSONPlaceholder API"
              },
              "resourcePath": {
                "type": "string",
                "value": "/posts",
                "description": "Resource to fetch"
              },
              "limit": {
                "type": "number",
                "value": 5,
                "description": "Number of items to show"
              }
            }
          },
          {
            "name": "Local",
            "description": "Local test API",
            "inputs": {
              "apiUrl": {
                "type": "string",
                "value": "http://localhost:5216",
                "required": true,
                "description": "Local API endpoint"
              },
              "resourcePath": {
                "type": "string",
                "value": "/api/projects",
                "description": "Resource to fetch"
              },
              "limit": {
                "type": "number",
                "value": 10,
                "description": "Number of items to show"
              }
            }
          }
        ],
        "selectedProfile": "Local"
      },
      "connections": [
        {
          "fromBlock": "start1",
          "fromPort": "apiUrl",
          "toBlock": "http1",
          "toPort": "apiUrl"
        },
        {
          "fromBlock": "start1",
          "fromPort": "resourcePath",
          "toBlock": "http1",
          "toPort": "resourcePath"
        }
      ]
    },
    {
      "id": "http1",
      "type": "http-request",
      "name": "Fetch Data",
      "description": "GET request to API",
      "config": {
        "method": "GET",
        "url": "{{apiUrl}}{{resourcePath}}",
        "successEvaluator": "statusCode === 200",
        "evaluatorLanguage": "typescript"
      },
      "inputPorts": [
        {
          "name": "apiUrl",
          "type": "string",
          "required": true
        },
        {
          "name": "resourcePath",
          "type": "string"
        }
      ],
      "outputPorts": [
        {
          "name": "response",
          "type": "array",
          "description": "API response data"
        },
        {
          "name": "success",
          "type": "any",
          "description": "Success response",
          "required": false,
          "multiple": false
        },
        {
          "name": "fail",
          "type": "any",
          "description": "Failure response",
          "required": false,
          "multiple": false
        }
      ],
      "outputs": {
        "response": "$"
      },
      "connections": [
        {
          "fromBlock": "http1",
          "fromPort": "success",
          "toBlock": "end1",
          "toPort": "data"
        }
      ]
    },
    {
      "id": "end1",
      "type": "end",
      "name": "Complete",
      "description": "Workflow completion",
      "config": {
        "outputs": {
          "data": {
            "type": "array",
            "value": "{{response}}",
            "description": "Retrieved data"
          }
        }
      },
      "inputPorts": [
        {
          "name": "data",
          "type": "array"
        }
      ]
    }
  ]
}
