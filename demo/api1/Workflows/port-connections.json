{
  "id": "test-port-connections-v2",
  "name": "Test Port-Based Connections",
  "description": "Demonstrates port-based data flow connections",
  "version": "2.0.0",
  "nodes": [
    {
      "id": "start1",
      "type": "start",
      "label": "Start",
      "data": {
        "inputs": {
          "apiUrl": { "type": "string", "required": true },
          "timeout": { "type": "number", "default": 5000 }
        },
        "profiles": [
          {
            "name": "Default",
            "default": true,
            "values": {
              "apiUrl": "http://localhost:5216",
              "timeout": 5000
            }
          }
        ]
      }
    },
    {
      "id": "http0",
      "type": "http-request",
      "label": "Get Projects List",
      "data": {
        "method": "GET",
        "url": "{{apiUrl}}/api/projects"
      }
    },
    {
      "id": "http1",
      "type": "http-request",
      "label": "Get Project",
      "data": {
        "method": "GET",
        "url": "{{apiUrl}}/api/projects/{{projectId}}"
      }
    },
    {
      "id": "http2",
      "type": "http-request",
      "label": "Get All Projects",
      "data": {
        "method": "GET",
        "url": "{{apiUrl}}/api/projects"
      }
    },
    {
      "id": "variable1",
      "type": "variable",
      "label": "Process Project Data",
      "data": {
        "operation": "set",
        "values": {
          "projectName": "{{userData.name}}",
          "projectDescription": "{{userData.description}}"
        }
      }
    },
    {
      "id": "end1",
      "type": "end",
      "label": "Complete",
      "data": {
        "outputs": {
          "projectName": { "value": "{{projectName}}" },
          "projectDescription": { "value": "{{projectDescription}}" },
          "allProjects": { "value": "{{allProjects}}" }
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "type": "execution", "source": "start1", "sourceHandle": "default", "target": "http0", "targetHandle": "trigger" },
    { "id": "e2", "type": "execution", "source": "start1", "sourceHandle": "default", "target": "http2", "targetHandle": "trigger" },
    { "id": "e3", "type": "execution", "source": "http0", "sourceHandle": "success", "target": "http1", "targetHandle": "trigger" },
    { "id": "e4", "type": "execution", "source": "http1", "sourceHandle": "success", "target": "variable1", "targetHandle": "trigger" },
    { "id": "e5", "type": "execution", "source": "variable1", "sourceHandle": "default", "target": "end1", "targetHandle": "trigger" },
    { "id": "e6", "type": "execution", "source": "http2", "sourceHandle": "success", "target": "end1", "targetHandle": "trigger" },

    { "id": "d1", "type": "data", "source": "start1", "sourceHandle": "apiUrl", "target": "http0", "targetHandle": "apiUrl" },
    { "id": "d2", "type": "data", "source": "start1", "sourceHandle": "apiUrl", "target": "http1", "targetHandle": "apiUrl" },
    { "id": "d3", "type": "data", "source": "start1", "sourceHandle": "apiUrl", "target": "http2", "targetHandle": "apiUrl" },
    { "id": "d4", "type": "data", "source": "http0", "sourceHandle": "body[0].id", "target": "http1", "targetHandle": "projectId" },
    { "id": "d5", "type": "data", "source": "http1", "sourceHandle": "body", "target": "variable1", "targetHandle": "userData" },
    { "id": "d6", "type": "data", "source": "variable1", "sourceHandle": "projectName", "target": "end1", "targetHandle": "projectName" },
    { "id": "d7", "type": "data", "source": "variable1", "sourceHandle": "projectDescription", "target": "end1", "targetHandle": "projectDescription" },
    { "id": "d8", "type": "data", "source": "http2", "sourceHandle": "body", "target": "end1", "targetHandle": "allProjects" }
  ]
}