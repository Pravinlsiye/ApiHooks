{
  "name": "Test HTTP JSONPath Extraction",
  "description": "Test HTTP request with JSONPath data extraction",
  "blocks": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "config": {
        "inputs": {
          "baseUrl": {
            "type": "string",
            "required": true,
            "default": "http://localhost:5216"
          }
        }
      },
      "onSuccess": "get-projects"
    },
    {
      "id": "get-projects",
      "type": "http-request",
      "name": "Get All Projects",
      "config": {
        "method": "GET",
        "url": "{{baseUrl}}/api/Projects"
      },
      "outputs": {
        "firstProjectName": "$[0].name",
        "allProjectNames": "$[*].name",
        "projectIds": "$[*].id",
        "allProjects": "$"
      },
      "onSuccess": "end"
    },
    {
      "id": "end",
      "type": "end",
      "name": "End",
      "config": {
        "outputs": {
          "firstProject": {
            "type": "string",
            "value": "{{firstProjectName}}"
          },
          "allNames": {
            "type": "array",
            "value": "{{allProjectNames}}"
          },
          "ids": {
            "type": "array",
            "value": "{{projectIds}}"
          },
          "allProjects": {
            "type": "array",
            "value": "{{allProjects}}"
          }
        }
      }
    }
  ]
}
