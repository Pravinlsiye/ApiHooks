{
  "name": "Test JSONPath with Posts API",
  "description": "Test HTTP request with JSONPath extraction using JSONPlaceholder API",
  "blocks": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "onSuccess": "get-posts"
    },
    {
      "id": "get-posts",
      "type": "http-request",
      "name": "Get Posts from JSONPlaceholder",
      "config": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/posts"
      },
      "outputs": {
        "allPosts": "$[*]",
        "firstPostTitle": "$[0].title",
        "firstPostId": "$[0].id",
        "firstFiveIds": "$[0:5].id",
        "firstTenTitles": "$[0:10].title"
      },
      "onSuccess": "end"
    },
    {
      "id": "end",
      "type": "end",
      "name": "End",
      "config": {
        "outputs": {
          "firstTitle": {
            "type": "string",
            "value": "{{firstPostTitle}}"
          },
          "firstId": {
            "type": "number",
            "value": "{{firstPostId}}"
          },
          "topFiveIds": {
            "type": "array",
            "value": "{{firstFiveIds}}"
          },
          "sampleTitles": {
            "type": "array",
            "value": "{{firstTenTitles}}"
          }
        }
      }
    }
  ]
}
