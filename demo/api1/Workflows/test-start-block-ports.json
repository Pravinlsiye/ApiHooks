{
  "name": "Test Start Block with Profiles and Ports",
  "description": "Demonstrates the enhanced Start block with profile selector and input/output ports",
  "version": "1.0",
  "blocks": [
    {
      "id": "start1",
      "type": "start",
      "name": "API Configuration",
      "description": "Start block with profiles and port-based connections",
      "config": {
        "profiles": [
          {
            "name": "Development",
            "description": "Local development settings",
            "default": true,
            "inputs": {
              "apiUrl": {
                "type": "string",
                "value": "http://localhost:5216",
                "required": true,
                "description": "API base URL"
              },
              "timeout": {
                "type": "number",
                "value": 5000,
                "description": "Request timeout in milliseconds"
              }
            }
          },
          {
            "name": "Production",
            "description": "Production environment settings",
            "inputs": {
              "apiUrl": {
                "type": "string",
                "value": "https://api.example.com",
                "required": true,
                "description": "API base URL"
              },
              "timeout": {
                "type": "number",
                "value": 30000,
                "description": "Request timeout in milliseconds"
              }
            }
          }
        ],
        "selectedProfile": "Development"
      },
      "connections": [
        {
          "fromBlock": "start1",
          "fromPort": "apiUrl",
          "toBlock": "http0",
          "toPort": "apiUrl"
        },
        {
          "fromBlock": "start1",
          "fromPort": "apiUrl",
          "toBlock": "log1",
          "toPort": "apiUrl"
        },
        {
          "fromBlock": "start1",
          "fromPort": "timeout",
          "toBlock": "log1",
          "toPort": "timeout"
        }
      ]
    },
    {
      "id": "http0",
      "type": "http-request",
      "name": "Get Projects List",
      "description": "Fetch list of projects to get a valid project ID",
      "config": {
        "method": "GET",
        "url": "{{apiUrl}}/api/projects"
      },
      "inputPorts": [
        {
          "name": "apiUrl",
          "type": "string",
          "required": true
        }
      ],
      "outputPorts": [
        {
          "name": "response",
          "type": "array",
          "description": "List of projects"
        },
        {
          "name": "firstProjectId",
          "type": "string",
          "description": "ID of the first project"
        }
      ],
      "outputs": {
        "firstProjectId": "$[0].id"
      },
      "connections": [
        {
          "fromBlock": "http0",
          "fromPort": "firstProjectId",
          "toBlock": "http1",
          "toPort": "projectId"
        },
        {
          "fromBlock": "start1",
          "fromPort": "apiUrl",
          "toBlock": "http1",
          "toPort": "apiUrl"
        }
      ]
    },
    {
      "id": "http1",
      "type": "http-request",
      "name": "Get Project Data",
      "description": "Fetch project information from API",
      "config": {
        "method": "GET",
        "url": "{{apiUrl}}/api/projects/{{projectId}}",
        "headers": {
          "Accept": "application/json"
        }
      },
      "inputPorts": [
        {
          "name": "apiUrl",
          "type": "string",
          "required": true
        },
        {
          "name": "projectId",
          "type": "string",
          "required": true
        }
      ],
      "outputPorts": [
        {
          "name": "response",
          "type": "object"
        }
      ],
      "outputs": {
        "userData": "$"
      },
      "connections": [
        {
          "fromBlock": "http1",
          "fromPort": "response",
          "toBlock": "log2",
          "toPort": "data"
        }
      ]
    },
    {
      "id": "log1",
      "type": "log",
      "name": "Log Configuration",
      "config": {
        "message": "Using API: {{apiUrl}} with timeout: {{timeout}}ms",
        "level": "info"
      },
      "inputPorts": [
        {
          "name": "apiUrl",
          "type": "string"
        },
        {
          "name": "timeout",
          "type": "number"
        }
      ],
      "connections": [
        {
          "fromBlock": "log1",
          "fromPort": "complete",
          "toBlock": "end1",
          "toPort": "complete"
        }
      ]
    },
    {
      "id": "log2",
      "type": "log",
      "name": "Log Response",
      "config": {
        "message": "Project data received: {{data}}",
        "level": "info"
      },
      "inputPorts": [
        {
          "name": "data",
          "type": "object"
        }
      ],
      "connections": [
        {
          "fromBlock": "log2",
          "fromPort": "complete",
          "toBlock": "end1",
          "toPort": "complete"
        }
      ]
    },
    {
      "id": "end1",
      "type": "end",
      "name": "Complete",
      "description": "Workflow completion",
      "config": {
        "outputs": {
          "result": {
            "type": "object",
            "value": "{{userData}}",
            "description": "Project data"
          }
        }
      },
      "inputPorts": [
        {
          "name": "complete",
          "type": "any"
        },
        {
          "name": "logComplete",
          "type": "any"
        }
      ]
    }
  ]
}
