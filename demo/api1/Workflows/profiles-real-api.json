{
  "id": "test-profiles-real-api-v2",
  "name": "Test Profiles with Real API",
  "description": "Demonstrates profile feature with real APIs and port-based connections",
  "version": "2.0.0",
  "nodes": [
    {
      "id": "start1",
      "type": "start",
      "label": "API Configuration",
      "data": {
        "inputs": {
          "apiUrl": { "type": "string", "description": "API Endpoint" },
          "resourcePath": { "type": "string", "description": "Path segment" },
          "limit": { "type": "number", "description": "Max items" }
        },
        "profiles": [
          {
            "name": "JSONPlaceholder",
            "description": "Public test API",
            "default": true,
            "values": {
              "apiUrl": "https://jsonplaceholder.typicode.com",
              "resourcePath": "/posts",
              "limit": 5
            }
          },
          {
            "name": "Local",
            "description": "Local test API",
            "values": {
              "apiUrl": "http://localhost:5216",
              "resourcePath": "/api/projects",
              "limit": 10
            }
          }
        ],
        "selectedProfile": "Local"
      }
    },
    {
      "id": "http1",
      "type": "http-request",
      "label": "Fetch Data",
      "data": {
        "method": "GET",
        "url": "{{apiUrl}}{{resourcePath}}",
        "successEvaluator": "statusCode === 200",
        "evaluatorLanguage": "typescript"
      }
    },
    {
      "id": "end1",
      "type": "end",
      "label": "Complete",
      "data": {
        "outputs": {
          "data": { "value": "{{response}}" }
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "type": "execution", "source": "start1", "sourceHandle": "default", "target": "http1", "targetHandle": "trigger" },
    { "id": "e2", "type": "execution", "source": "http1", "sourceHandle": "success", "target": "end1", "targetHandle": "trigger" },
    
    { "id": "d1", "type": "data", "source": "start1", "sourceHandle": "apiUrl", "target": "http1", "targetHandle": "apiUrl" },
    { "id": "d2", "type": "data", "source": "start1", "sourceHandle": "resourcePath", "target": "http1", "targetHandle": "resourcePath" },
    { "id": "d3", "type": "data", "source": "http1", "sourceHandle": "body", "target": "end1", "targetHandle": "data" }
  ]
}