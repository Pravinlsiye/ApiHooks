{
  "name": "Test Variable Block",
  "description": "Tests variable set, get, and delete operations",
  "version": "1.0",
  "blocks": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "onSuccess": "set-vars"
    },
    {
      "id": "set-vars",
      "type": "variable", 
      "name": "Set Variables",
      "config": {
        "operation": "set",
        "variables": {
          "userName": "Alice",
          "userAge": 25,
          "timestamp": "{{$timestamp}}",
          "greeting": "Hello, {{userName}}!"
        }
      },
      "onSuccess": "get-vars"
    },
    {
      "id": "get-vars",
      "type": "variable",
      "name": "Get Variables",
      "config": {
        "operation": "get",
        "variables": {
          "userName": null,
          "userAge": null,
          "greeting": null
        }
      },
      "onSuccess": "set-more-vars"
    },
    {
      "id": "set-more-vars",
      "type": "variable",
      "name": "Set More Variables",
      "config": {
        "operation": "set",
        "variables": {
          "fullProfile": {
            "name": "{{userName}}",
            "age": "{{userAge}}",
            "created": "{{timestamp}}"
          },
          "welcome": "Welcome {{userName}}, you are {{userAge}} years old"
        }
      },
      "onSuccess": "delete-vars"
    },
    {
      "id": "delete-vars",
      "type": "variable",
      "name": "Delete Variables",
      "config": {
        "operation": "delete",
        "variables": {
          "userAge": null
        }
      },
      "onSuccess": "end"
    },
    {
      "id": "end",
      "type": "end",
      "name": "End",
      "config": {
        "outputs": {
          "finalUserName": {
            "type": "string",
            "value": "{{userName}}"
          },
          "finalGreeting": {
            "type": "string",
            "value": "{{greeting}}"
          },
          "profile": {
            "type": "object",
            "value": "{{fullProfile}}"
          },
          "welcomeMessage": {
            "type": "string",
            "value": "{{welcome}}"
          },
          "deletedAge": {
            "type": "any",
            "value": "{{userAge}}"
          }
        }
      }
    }
  ]
}
