{
  "name": "Test HTTP POST - JSONPlaceholder",
  "description": "Test creating resources with POST using JSONPlaceholder API",
  "blocks": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "config": {
        "inputs": {
          "title": {
            "type": "string",
            "required": true,
            "default": "Test Post"
          },
          "body": {
            "type": "string",
            "required": true,
            "default": "This is a test post created by workflow"
          },
          "userId": {
            "type": "number",
            "required": true,
            "default": 1
          }
        }
      },
      "onSuccess": "create-post"
    },
    {
      "id": "create-post",
      "type": "http-request",
      "name": "Create Post",
      "config": {
        "method": "POST",
        "url": "https://jsonplaceholder.typicode.com/posts",
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "body": {
          "title": "{{title}}",
          "body": "{{body}}",
          "userId": "{{userId}}"
        }
      },
      "outputs": {
        "postId": "$.id",
        "createdTitle": "$.title",
        "createdBody": "$.body",
        "createdUserId": "$.userId"
      },
      "onSuccess": "end",
      "onFailure": "error"
    },
    {
      "id": "end",
      "type": "end",
      "name": "Success",
      "config": {
        "outputs": {
          "newPostId": {
            "type": "number",
            "value": "{{postId}}"
          },
          "postTitle": {
            "type": "string",
            "value": "{{createdTitle}}"
          },
          "postBody": {
            "type": "string",
            "value": "{{createdBody}}"
          },
          "authorId": {
            "type": "number",
            "value": "{{createdUserId}}"
          }
        }
      }
    },
    {
      "id": "error",
      "type": "end",
      "name": "Error",
      "config": {
        "outputs": {
          "error": {
            "type": "string",
            "value": "Failed to create post"
          }
        }
      }
    }
  ]
}
