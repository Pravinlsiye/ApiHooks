{
  "name": "Test HTTP Block",
  "description": "Simple test for HTTP request block",
  "blocks": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "config": {
        "inputs": {
          "apiUrl": {
            "type": "string",
            "required": true,
            "default": "http://localhost:5216"
          }
        }
      },
      "onSuccess": "http-get"
    },
    {
      "id": "http-get",
      "type": "http-request",
      "name": "Test GET Request",
      "config": {
        "method": "GET",
        "url": "{{apiUrl}}/api/projects",
        "headers": {
          "Accept": "application/json"
        }
      },
      "outputs": {
        "projects": "$",
        "count": "$.length"
      },
      "onSuccess": "end"
    },
    {
      "id": "end",
      "type": "end",
      "name": "End",
      "config": {
        "outputs": {
          "totalProjects": {
            "type": "number",
            "value": "{{count}}"
          }
        }
      }
    }
  ]
}
