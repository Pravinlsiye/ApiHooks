{
  "name": "HTTP Connection Test",
  "description": "Simple test to verify connections between HTTP blocks",
  "blocks": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "config": {
        "inputs": {
          "baseUrl": {
            "type": "string",
            "required": true,
            "default": "http://localhost:5216"
          }
        }
      },
      "onSuccess": "first-call"
    },
    {
      "id": "first-call",
      "type": "http-request",
      "name": "First API Call",
      "config": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects"
      },
      "onSuccess": "second-call",
      "onFailure": "end"
    },
    {
      "id": "second-call",
      "type": "http-request",
      "name": "Second API Call",
      "config": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects"
      },
      "onSuccess": "end"
    },
    {
      "id": "end",
      "type": "end",
      "name": "End",
      "config": {
        "outputs": {
          "completed": {
            "type": "boolean",
            "value": true
          }
        }
      }
    }
  ]
}
