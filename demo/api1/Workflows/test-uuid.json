{
  "id": "test-uuid",
  "name": "UUID Generator Test",
  "description": "Generates random UUIDs using httpbin",
  "version": "2.0.0",
  "nodes": [
    {
      "id": "start1",
      "type": "start",
      "label": "Start",
      "data": {
        "profiles": [
          {
            "name": "Default",
            "default": true,
            "inputs": {}
          }
        ],
        "inputs": {},
        "selectedProfile": "Default"
      }
    },
    {
      "id": "http1",
      "type": "http-request",
      "label": "Generate UUID",
      "data": {
        "method": "GET",
        "url": "https://httpbin.org/uuid",
        "headers": {},
        "outputs": {
          "uuid": "$.uuid"
        }
      }
    },
    {
      "id": "log1",
      "type": "log",
      "label": "Log UUID",
      "data": {
        "message": "🆔 Generated UUID: {{uuid}}",
        "level": "info"
      }
    },
    {
      "id": "http2",
      "type": "http-request",
      "label": "Get Request Info",
      "data": {
        "method": "GET",
        "url": "https://httpbin.org/headers",
        "headers": {
          "X-Custom-UUID": "{{uuid}}"
        },
        "outputs": {
          "userAgent": "$.headers.User-Agent",
          "customUUID": "$.headers.X-Custom-Uuid"
        }
      }
    },
    {
      "id": "log2",
      "type": "log",
      "label": "Log Headers",
      "data": {
        "message": "📋 User-Agent: {{userAgent}} | Custom UUID Header: {{customUUID}}",
        "level": "info"
      }
    },
    {
      "id": "end1",
      "type": "end",
      "label": "Complete",
      "data": {
        "outputs": {
          "generatedUUID": { "value": "{{uuid}}", "type": "string" },
          "userAgent": { "value": "{{userAgent}}", "type": "string" }
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "type": "execution", "source": "start1", "sourceHandle": "default", "target": "http1", "targetHandle": "trigger" },
    { "id": "e2", "type": "execution", "source": "http1", "sourceHandle": "success", "target": "log1", "targetHandle": "trigger" },
    { "id": "e3", "type": "execution", "source": "log1", "sourceHandle": "success", "target": "http2", "targetHandle": "trigger" },
    { "id": "e4", "type": "execution", "source": "http2", "sourceHandle": "success", "target": "log2", "targetHandle": "trigger" },
    { "id": "e5", "type": "execution", "source": "log2", "sourceHandle": "success", "target": "end1", "targetHandle": "trigger" }
  ],
  "layout": {
    "start1": { "x": 100, "y": 200 },
    "http1": { "x": 350, "y": 200 },
    "log1": { "x": 600, "y": 200 },
    "http2": { "x": 850, "y": 200 },
    "log2": { "x": 1100, "y": 200 },
    "end1": { "x": 1350, "y": 200 }
  }
}

