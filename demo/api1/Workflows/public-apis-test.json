{
  "id": "cat-facts-workflow",
  "name": "Get Random Cat Fact",
  "version": "2.0.0",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "Configuration",
      "data": {
        "inputs": {
          "baseUrl": { "type": "string", "default": "https://catfact.ninja" }
        },
        "profiles": [
          {
            "name": "Default",
            "default": true,
            "values": {
              "baseUrl": "https://catfact.ninja"
            }
          }
        ]
      }
    },
    {
      "id": "http-get-fact",
      "type": "http-request",
      "label": "Fetch Fact",
      "data": {
        "method": "GET",
        "url": "{{baseUrl}}/fact",
        "outputs": {
          "fact": "$.fact",
          "length": "$.length"
        }
      }
    },
    {
      "id": "log-fact",
      "type": "log",
      "label": "Print Fact",
      "data": {
        "message": "Did you know? {{fact}}"
      }
    },
    {
      "id": "end",
      "type": "end",
      "label": "Success",
      "data": {
        "outputs": {
          "fact": { "value": "{{fact}}" },
          "length": { "value": "{{length}}" }
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "type": "execution", "source": "start", "target": "http-get-fact" },
    { "id": "e2", "type": "execution", "source": "http-get-fact", "sourceHandle": "success", "target": "log-fact" },
    { "id": "e3", "type": "execution", "source": "log-fact", "target": "end" },

    { "id": "d1", "type": "data", "source": "start", "sourceHandle": "baseUrl", "target": "http-get-fact", "targetHandle": "baseUrl" },
    { "id": "d2", "type": "data", "source": "http-get-fact", "sourceHandle": "body.fact", "target": "log-fact", "targetHandle": "fact" },
    { "id": "d3", "type": "data", "source": "http-get-fact", "sourceHandle": "body.fact", "target": "end", "targetHandle": "fact" },
    { "id": "d4", "type": "data", "source": "http-get-fact", "sourceHandle": "body.length", "target": "end", "targetHandle": "length" }
  ]
}
