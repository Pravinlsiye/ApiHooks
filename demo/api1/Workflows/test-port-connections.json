{
  "name": "Test Port-Based Connections",
  "description": "Demonstrates port-based data flow connections",
  "version": "1.0",
  "blocks": [
    {
      "id": "start1",
      "type": "start",
      "name": "Start",
      "config": {
        "inputs": {
          "apiUrl": {
            "type": "string",
            "value": "http://localhost:5216",
            "required": true,
            "description": "API endpoint URL"
          },
          "timeout": {
            "type": "number",
            "value": 5000,
            "description": "Request timeout"
          }
        }
      },
      "outputPorts": [
        {
          "name": "apiUrl",
          "type": "string",
          "multiple": true
        },
        {
          "name": "timeout",
          "type": "number",
          "multiple": true
        }
      ],
      "connections": [
        {
          "fromBlock": "start1",
          "fromPort": "apiUrl",
          "toBlock": "http0",
          "toPort": "url"
        }
      ]
    },
    {
      "id": "http0",
      "type": "http-request",
      "name": "Get Projects List",
      "config": {
        "method": "GET",
        "url": "{{url}}/api/projects"
      },
      "inputPorts": [
        {
          "name": "url",
          "type": "string",
          "required": true
        }
      ],
      "outputPorts": [
        {
          "name": "response",
          "type": "array",
          "description": "List of projects"
        },
        {
          "name": "firstProjectId",
          "type": "string",
          "description": "ID of the first project"
        }
      ],
      "outputs": {
        "firstProjectId": "$[0].id"
      },
      "connections": [
        {
          "fromBlock": "http0",
          "fromPort": "firstProjectId",
          "toBlock": "http1",
          "toPort": "projectId"
        },
        {
          "fromBlock": "start1",
          "fromPort": "apiUrl",
          "toBlock": "http1",
          "toPort": "url"
        },
        {
          "fromBlock": "start1",
          "fromPort": "apiUrl",
          "toBlock": "http2",
          "toPort": "url"
        }
      ]
    },
    {
      "id": "http1",
      "type": "http-request",
      "name": "Get Project",
      "config": {
        "method": "GET",
        "url": "{{url}}/api/projects/{{projectId}}"
      },
      "inputPorts": [
        {
          "name": "url",
          "type": "string",
          "required": true
        },
        {
          "name": "projectId",
          "type": "string",
          "required": true
        }
      ],
      "outputPorts": [
        {
          "name": "response",
          "type": "object",
          "multiple": true
        },
        {
          "name": "status",
          "type": "number",
          "multiple": false
        }
      ],
      "connections": [
        {
          "fromBlock": "http1",
          "fromPort": "response",
          "toBlock": "variable1",
          "toPort": "userData"
        }
      ]
    },
    {
      "id": "http2",
      "type": "http-request",
      "name": "Get All Projects",
      "config": {
        "method": "GET",
        "url": "{{url}}/api/projects"
      },
      "inputPorts": [
        {
          "name": "url",
          "type": "string",
          "required": true
        }
      ],
      "outputPorts": [
        {
          "name": "response",
          "type": "array",
          "multiple": true
        },
        {
          "name": "count",
          "type": "number"
        }
      ]
    },
    {
      "id": "variable1",
      "type": "variable",
      "name": "Process Project Data",
      "config": {
        "operation": "set",
        "variables": {
          "projectName": "{{userData.name}}",
          "projectDescription": "{{userData.description}}"
        }
      },
      "inputPorts": [
        {
          "name": "userData",
          "type": "object",
          "required": true
        }
      ],
      "outputPorts": [
        {
          "name": "projectName",
          "type": "string"
        },
        {
          "name": "projectDescription",
          "type": "string"
        }
      ],
      "connections": [
        {
          "fromBlock": "variable1",
          "fromPort": "projectName",
          "toBlock": "end1",
          "toPort": "projectName"
        },
        {
          "fromBlock": "variable1",
          "fromPort": "projectDescription",
          "toBlock": "end1",
          "toPort": "projectDescription"
        }
      ]
    },
    {
      "id": "end1",
      "type": "end",
      "name": "Complete",
      "description": "Workflow completion",
      "config": {
        "outputs": {
          "projectName": {
            "type": "string",
            "value": "{{projectName}}"
          },
          "projectDescription": {
            "type": "string",
            "value": "{{projectDescription}}"
          }
        }
      },
      "inputPorts": [
        {
          "name": "projectName",
          "type": "string"
        },
        {
          "name": "projectDescription",
          "type": "string"
        }
      ]
    }
  ]
}
