{
  "name": "Test HTTP POST",
  "description": "Test creating resources with POST",
  "blocks": [
    {
      "id": "start",
      "type": "start",
      "name": "Start",
      "config": {
        "inputs": {
          "apiUrl": {
            "type": "string",
            "required": true,
            "default": "http://localhost:5216"
          },
          "projectName": {
            "type": "string",
            "required": true,
            "default": "Test Project"
          }
        }
      },
      "onSuccess": "create-project"
    },
    {
      "id": "create-project",
      "type": "http-request",
      "name": "Create Project",
      "config": {
        "method": "POST",
        "url": "{{apiUrl}}/api/projects",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{projectName}}",
          "description": "Created by workflow test"
        }
      },
      "outputs": {
        "projectId": "$.id",
        "createdName": "$.name"
      },
      "onSuccess": "end",
      "onFailure": "error"
    },
    {
      "id": "end",
      "type": "end",
      "name": "Success",
      "config": {
        "outputs": {
          "newProjectId": {
            "type": "string",
            "value": "{{projectId}}"
          },
          "projectName": {
            "type": "string",
            "value": "{{createdName}}"
          }
        }
      }
    },
    {
      "id": "error",
      "type": "end",
      "name": "Error",
      "config": {
        "outputs": {
          "error": {
            "type": "string",
            "value": "Failed to create project"
          }
        }
      }
    }
  ]
}
